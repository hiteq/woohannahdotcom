---
import BaseLayout from "../layouts/BaseLayout.astro"
import { loadAllContent } from "../lib/content"
import { fetchOgImage, extractFirstLink } from "../lib/og-image"

const all = await loadAllContent()
const press = all.find((e) => e.type === "page" && e.slug[0] === "press")
if (!press) throw new Error("Press page not found in content/Press/Press.md")

/* bodyHtml을 <h2> 기준으로 섹션 분리 */
type PressItem = {
  title: string
  thumbnail: string | null
  html: string
  imageCount: number
  hasVideo: boolean
  firstLinkUrl: string | null
  isLinkOnly: boolean
}

function parseSections(html: string): PressItem[] {
  const items: PressItem[] = []
  const parts = html.split(/<h2>(.*?)<\/h2>/g)
  for (let i = 1; i < parts.length; i += 2) {
    const title = parts[i].trim()
    const content = (parts[i + 1] || "").trim()
    const imgMatch = content.match(/<img\s+[^>]*src="([^"]+)"/)
    const imageCount = (content.match(/<img\s/g) || []).length
    const firstLinkUrl = extractFirstLink(content)
    items.push({
      title,
      thumbnail: imgMatch?.[1] ?? null,
      html: content,
      imageCount,
      hasVideo: /youtube\.com|youtu\.be/i.test(content),
      firstLinkUrl,
      isLinkOnly: imageCount === 0 && firstLinkUrl !== null,
    })
  }
  return items
}

const items = parseSections(press.bodyHtml)

/* 이미지 없는 섹션에 OG 이미지 가져오기 (빌드 타임) */
await Promise.all(
  items.map(async (item) => {
    if (item.thumbnail || item.imageCount > 0) return
    const link = extractFirstLink(item.html)
    if (!link) return
    const ogImg = await fetchOgImage(link)
    if (ogImg) {
      item.thumbnail = ogImg
      item.imageCount = 1
    }
  }),
)

/* 벤토 그리드 크기: 이미지 수에 따라 카드 크기 결정 */
const gridClasses: string[] = []
let multiToggle = 0
for (const item of items) {
  if (item.imageCount >= 4)
    gridClasses.push("lg:col-span-2 lg:row-span-2")
  else if (item.imageCount >= 2)
    gridClasses.push(multiToggle++ % 2 === 0 ? "lg:row-span-2" : "lg:col-span-2")
  else
    gridClasses.push("")
}

/* 마지막 행 균형 조정: 1×1 아이템이 3열에 꽉 차지 않으면 마지막 아이템 확장 */
const smallCount = gridClasses.filter((c) => c === "").length
if (smallCount > 0 && smallCount % 3 === 1) {
  const lastIdx = gridClasses.lastIndexOf("")
  gridClasses[lastIdx] = "lg:col-span-3"
} else if (smallCount > 0 && smallCount % 3 === 2) {
  const lastIdx = gridClasses.lastIndexOf("")
  gridClasses[lastIdx] = "lg:col-span-2"
}
---

<BaseLayout title="Press · WOO HANNAH">
  <h1 class="page-title mb-10 text-3xl font-bold">Press</h1>

  <!-- Bento Grid -->
  <div class="press-grid" id="grid">
    {items.map((item, i) => {
      const cardContent = (
        <>
          {item.thumbnail ? (
            <img src={item.thumbnail} alt={item.title} class="press-card-img" loading="lazy" />
          ) : (
            <div class="press-card-empty">
              {item.hasVideo ? (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
              )}
            </div>
          )}
          <span class="press-card-label">{item.title}</span>
        </>
      )
      const cardClass = ["press-card group", gridClasses[i]]
      if (item.isLinkOnly && item.firstLinkUrl) {
        return (
          <a
            href={item.firstLinkUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[...cardClass, "no-underline hover:no-underline"]}
          >
            {cardContent}
          </a>
        )
      }
      return (
        <button class:list={cardClass} data-idx={i} type="button">
          {cardContent}
        </button>
      )
    })}
  </div>

  <!-- 확대 오버레이 -->
  <div id="overlay" class="press-overlay" aria-hidden="true">
    <div class="press-overlay-bg" id="overlayBg"></div>
    <div class="press-overlay-panel prose prose-zinc" id="overlayPanel">
      <button id="closeBtn" type="button" class="press-close-btn" aria-label="닫기">&times;</button>
      <h2 id="oTitle"></h2>
      <div id="oBody"></div>
    </div>
  </div>
</BaseLayout>

<!-- 섹션 데이터를 클라이언트에 전달 -->
<script define:vars={{ itemsData: items.map(({ title, html }) => ({ title, html })) }}>
  window.__pressItems = itemsData
</script>

<script>
  const grid = document.getElementById("grid")!
  const overlay = document.getElementById("overlay")!
  const overlayBg = document.getElementById("overlayBg")!
  const oTitle = document.getElementById("oTitle")!
  const oBody = document.getElementById("oBody")!
  const closeBtn = document.getElementById("closeBtn")!

  function open(idx: number) {
    const item = (window as any).__pressItems[idx]
    if (!item) return
    oTitle.textContent = item.title
    oBody.innerHTML = item.html
    overlay.classList.add("active")
    overlay.setAttribute("aria-hidden", "false")
    document.body.style.overflow = "hidden"
  }

  function close() {
    overlay.classList.remove("active")
    overlay.setAttribute("aria-hidden", "true")
    document.body.style.overflow = ""
  }

  grid.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-idx]")
    if (btn) open(Number(btn.dataset.idx))
  })

  overlayBg.addEventListener("click", close)
  closeBtn.addEventListener("click", close)
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close()
  })
</script>

<style is:global>
  /* ── Bento Grid ── */
  .press-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 200px;
    grid-auto-flow: dense;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .press-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .press-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Card ── */
  .press-card {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #fafafa;
    border: 1px solid #e4e4e7;
    cursor: pointer;
    padding: 0;
    text-align: left;
    transition: box-shadow 0.3s, border-color 0.3s;
  }
  .press-card:hover {
    border-color: #a1a1aa;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  }
  .press-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .press-card:hover .press-card-img {
    transform: scale(1.04);
  }
  .press-card-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: #f4f4f5;
  }
  .press-card-label {
    position: absolute;
    inset: auto 0 0;
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: opacity 0.3s;
  }
  /* 이미지 카드: 항상 라벨 표시 */
  .press-card:has(.press-card-img) .press-card-label {
    background: linear-gradient(transparent, rgba(0,0,0,0.55));
    color: #fff;
  }
  /* 이미지 없는 카드: 항상 라벨 표시 */
  .press-card:has(.press-card-empty) .press-card-label {
    color: #52525b;
  }

  /* ── Overlay ── */
  .press-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .press-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }
  .press-overlay-bg {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
  }
  .press-overlay-panel {
    position: relative;
    width: min(90vw, 48rem);
    max-height: 85vh;
    overflow-y: auto;
    padding: 2.5rem;
    background: #fff;
    border-radius: 1rem;
    box-shadow: 0 25px 60px rgba(0,0,0,0.25);
    transform: scale(0.96) translateY(8px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .press-overlay.active .press-overlay-panel {
    transform: scale(1) translateY(0);
  }
  .press-close-btn {
    position: sticky;
    top: 0;
    float: right;
    font-size: 1.75rem;
    line-height: 1;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(4px);
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    color: #71717a;
    padding: 0.25rem 0.5rem;
    transition: color 0.2s;
    z-index: 1;
  }
  .press-close-btn:hover {
    color: #18181b;
  }
  /* 오버레이 내부 이미지 스타일 */
  .press-overlay-panel img {
    border-radius: 0.5rem;
  }
</style>
