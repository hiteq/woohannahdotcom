---
import BaseLayout from "../layouts/BaseLayout.astro"
import { loadAllContent } from "../lib/content"

const all = await loadAllContent()

// content/Press/Press.md -> slug ["press","press"] -> url /press (we keep only first in routing)
const press = all.find((e) => e.type === "page" && e.slug[0] === "press")

if (!press) {
  throw new Error("Press page not found in content/Press/Press.md")
}
---

<BaseLayout title="Press · Hannah Woo" description={press.description}>
  <article class="prose prose-zinc max-w-none">
    <h1>{press.title}</h1>
    <Fragment set:html={press.bodyHtml} />
  </article>
</BaseLayout>

