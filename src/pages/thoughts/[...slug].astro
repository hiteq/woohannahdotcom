---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { loadAllContent } from "../../lib/content"

export async function getStaticPaths() {
  const all = await loadAllContent()
  const thoughts = all.filter((e) => e.type === "thought")
  return thoughts.map((t) => ({
    params: { slug: t.slug.join("/") },
    props: { entry: t },
  }))
}

const { entry } = Astro.props
---

<BaseLayout title={`${entry.title} · Hannah Woo`} description={entry.description}>
  <article class="prose prose-zinc max-w-none">
    <h1>{entry.title}</h1>
    {entry.date && (
      <p class="mt-2 text-sm text-zinc-600">
        {entry.date.slice(0, 10)}
      </p>
    )}
    <Fragment set:html={entry.bodyHtml} />
  </article>
</BaseLayout>
