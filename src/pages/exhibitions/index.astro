---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { loadAllContent, sortByDateDesc } from "../../lib/content"

const all = await loadAllContent()
const exhibitions = sortByDateDesc(all.filter((e) => e.type === "exhibition"))
const baseRaw = import.meta.env.BASE_URL
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`
---

<BaseLayout title="Exhibitions · Hannah Woo" description="Exhibitions">
  <div class="mb-8 border-b border-zinc-200 pb-4">
    <h1 class="text-3xl font-bold">Exhibitions</h1>
  </div>
  
  <div class="flex flex-col gap-16">
    {exhibitions.map((e) => (
      <div class="flex flex-col border-b border-zinc-100 pb-12 last:border-0 last:pb-0">
        <a
          href={`${base}exhibitions/${e.slug.join("/")}/`}
          class="group block no-underline"
        >
          <div class="w-full bg-zinc-50 mb-6 overflow-hidden">
            {e.thumbnail ? (
              <img
                src={e.thumbnail}
                alt={e.title}
                class="w-full h-auto max-h-[75vh] object-cover group-hover:scale-[1.02] transition-transform duration-500"
                loading="lazy"
              />
            ) : (
              <div class="w-full aspect-video flex items-center justify-center text-zinc-400">
                No image
              </div>
            )}
          </div>
          <h3 class="text-3xl font-medium text-zinc-900 group-hover:text-zinc-600 transition-colors">
            {e.title}
          </h3>
          <div class="mt-3 flex flex-col gap-2">
            <span class="text-sm text-zinc-500">
              {[e.date?.slice(0, 10).replace(/\-/g, '.'), e.category].filter(Boolean).join(" · ")}
            </span>
            {e.description && (
              <p class="mt-2 text-base text-zinc-600 leading-relaxed whitespace-pre-wrap">
                {e.description}
              </p>
            )}
          </div>
        </a>
      </div>
    ))}
  </div>
</BaseLayout>
