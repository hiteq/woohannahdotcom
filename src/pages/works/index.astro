---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { loadAllContent, sortByDateDesc, groupWorksBySeries } from "../../lib/content"

const all = await loadAllContent()
const rawWorks = sortByDateDesc(all.filter((e) => e.type === "work"))
const groupedWorks = groupWorksBySeries(rawWorks)

const baseRaw = import.meta.env.BASE_URL
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`
---

<BaseLayout title="Works · WOO HANNAH" description="Works">
  <div class="mb-8 pb-4">
    <h1 class="page-title text-3xl font-bold">Works</h1>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {groupedWorks.map((w, index) => (
      <a
        href={w.isSeries ? `${base}works/series/${w.seriesSlug}/` : `${base}works/${w.slug.join("/")}/`}
        class="group block no-underline"
      >
        <div class="mb-3 aspect-[4/3] overflow-hidden rounded-xl bg-zinc-100 md:rounded-2xl">
          {w.thumbnail ? (
            <img
              src={w.thumbnail}
              alt={w.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "auto"}
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center text-zinc-400">
              No image
            </div>
          )}
        </div>
        <h3 class="font-medium text-zinc-900 group-hover:text-zinc-600 transition-colors">
          {w.title}
        </h3>
        <div class="flex items-center gap-2 text-sm text-zinc-500">
          {w.year && <span>{w.year}</span>}
          {w.category && (
            <>
              {w.year && <span>·</span>}
              <span class="capitalize">{w.category}</span>
            </>
          )}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
