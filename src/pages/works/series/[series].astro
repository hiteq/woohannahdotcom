---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import { loadAllContent, sortByDateDesc } from "../../../lib/content"

export async function getStaticPaths() {
  const all = await loadAllContent()
  const works = all.filter((e) => e.type === "work" && e.series)
  const seriesNames = [...new Set(works.map(w => w.series))]
  
  return seriesNames.map(series => {
    const slug = series!.toLowerCase().replace(/\s+/g, '-')
    return {
      params: { series: slug },
      props: { 
        seriesTitle: series,
        works: sortByDateDesc(works.filter(w => w.series === series))
      }
    }
  })
}

const { seriesTitle, works } = Astro.props
const baseRaw = import.meta.env.BASE_URL
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`
---

<BaseLayout title={`${seriesTitle} · WOO HANNAH`} description={`Series: ${seriesTitle}`}>
  <div class="mb-8 border-b border-zinc-200 pb-4">
    <a href={`${base}works/`} class="text-sm text-zinc-500 hover:text-zinc-900 mb-2 inline-block">← Back to Works</a>
    <h1 class="text-3xl font-bold">{seriesTitle}</h1>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {works.map((w) => (
      <a
        href={`${base}works/${w.slug.join("/")}/`}
        class="group block no-underline"
      >
        <div class="aspect-[4/3] overflow-hidden bg-zinc-100 mb-3">
          {w.thumbnail ? (
            <img
              src={w.thumbnail}
              alt={w.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center text-zinc-400">
              No image
            </div>
          )}
        </div>
        <h3 class="font-medium text-zinc-900 group-hover:text-zinc-600 transition-colors">
          {w.title}
        </h3>
        <div class="flex items-center gap-2 text-sm text-zinc-500">
          {w.year && <span>{w.year}</span>}
          {w.category && (
            <>
              {w.year && <span>·</span>}
              <span class="capitalize">{w.category}</span>
            </>
          )}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
