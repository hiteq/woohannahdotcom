---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { loadAllContent } from "../../lib/content"

export async function getStaticPaths() {
  const all = await loadAllContent()
  const works = all.filter((e) => e.type === "work")
  return works.map((w) => ({ params: { slug: w.slug.join("/") }, props: { entry: w } }))
}

const { entry } = Astro.props
---

<BaseLayout title={`${entry.title} · Hannah Woo`} description={entry.description}>
  <article class="prose prose-zinc max-w-none">
    <h1>{entry.title}</h1>
    <p class="mt-2 text-sm text-zinc-600">
      {[entry.year, entry.category, entry.medium, entry.dimensions].filter(Boolean).join(" · ")}
    </p>
    <Fragment set:html={entry.bodyHtml} />
  </article>
</BaseLayout>

