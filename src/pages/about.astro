---
import BaseLayout from "../layouts/BaseLayout.astro"
import { loadAllContent } from "../lib/content"

const all = await loadAllContent()
const about = all.find((e) => e.type === "page" && e.slug.join("/") === "about")

if (!about) {
  throw new Error("About page not found in content/About.md")
}
---

<BaseLayout title="About · WOO HANNAH" description={about.description}>
  <article class="prose prose-zinc max-w-none">
    <h1>{about.title}</h1>
    
    {about.englishHtml ? (
      <div id="language-tabs" class="not-prose mb-8">
        <div class="inline-flex items-center text-zinc-500">
          <button 
            id="btn-kor"
            class="inline-flex items-center justify-center whitespace-nowrap px-0 py-1 text-sm font-medium text-zinc-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2 data-[state=active]:text-zinc-950 cursor-pointer hover:text-zinc-950"
            data-state="active"
          >
            한국어
          </button>
          <span aria-hidden="true" class="mx-2.5 h-3 w-px bg-zinc-300"></span>
          <button 
            id="btn-eng"
            class="inline-flex items-center justify-center whitespace-nowrap px-0 py-1 text-sm font-medium text-zinc-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2 data-[state=active]:text-zinc-950 cursor-pointer hover:text-zinc-950"
            data-state="inactive"
          >
            English
          </button>
        </div>
      </div>

      <div id="content-kor">
        <Fragment set:html={about.bodyHtml} />
      </div>
      <div id="content-eng" class="hidden">
        <Fragment set:html={about.englishHtml} />
      </div>

      <script>
        const btnKor = document.getElementById('btn-kor');
        const btnEng = document.getElementById('btn-eng');
        const contentKor = document.getElementById('content-kor');
        const contentEng = document.getElementById('content-eng');

        if (btnKor && btnEng && contentKor && contentEng) {
          btnKor.addEventListener('click', () => {
            btnKor.setAttribute('data-state', 'active');
            btnEng.setAttribute('data-state', 'inactive');
            contentKor.classList.remove('hidden');
            contentEng.classList.add('hidden');
          });

          btnEng.addEventListener('click', () => {
            btnKor.setAttribute('data-state', 'inactive');
            btnEng.setAttribute('data-state', 'active');
            contentKor.classList.add('hidden');
            contentEng.classList.remove('hidden');
          });
        }
      </script>
    ) : (
      <Fragment set:html={about.bodyHtml} />
    )}
  </article>
</BaseLayout>
