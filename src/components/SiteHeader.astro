---
interface Props {
  currentPath?: string
}
const { currentPath = "" } = Astro.props
const nav = [
  { href: "", label: "Home" },
  { href: "works/", label: "Works" },
  { href: "exhibitions/", label: "Exhibitions" },
  { href: "thoughts/", label: "Thoughts" },
  { href: "press/", label: "Press" },
  { href: "about/", label: "About" },
]
const homeLink = nav[0]
const aboutLink = nav[nav.length - 1]
const centerNav = nav.slice(1, -1)
const baseRaw = import.meta.env.BASE_URL
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`
const path = currentPath.replace(/\/$/, "") || "/"
function isActive(href: string): boolean {
  if (href === "") return path === "" || path === "/"
  const segment = href.replace(/\/$/, "")
  return path === `/${segment}` || path.startsWith(`/${segment}/`)
}
---

<header class="relative z-40 bg-white/80 backdrop-blur">
  <div class="mx-auto hidden max-w-5xl items-center gap-6 px-4 py-4 md:flex">
    <a
      href={`${base}${homeLink.href}`}
      class={`shrink-0 text-sm text-zinc-700 hover:text-zinc-900 no-underline hover:no-underline ${isActive(homeLink.href) ? "font-bold" : ""}`}
    >
      {homeLink.label}
    </a>

    <div class="relative flex min-w-0 flex-1 items-center justify-center">
      <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-zinc-200"></div>
      <nav class="relative flex items-center justify-center gap-6 bg-white/80 px-6 text-sm">
        {centerNav.map((i) => (
          <a
            href={`${base}${i.href}`}
            class={`text-zinc-700 hover:text-zinc-900 no-underline hover:no-underline ${isActive(i.href) ? "font-bold" : ""}`}
          >
            {i.label}
          </a>
        ))}
      </nav>
    </div>

    <a
      href={`${base}${aboutLink.href}`}
      class={`shrink-0 text-sm text-zinc-700 hover:text-zinc-900 no-underline hover:no-underline ${isActive(aboutLink.href) ? "font-bold" : ""}`}
    >
      {aboutLink.label}
    </a>
  </div>

  <div class="mx-auto flex max-w-5xl items-center justify-end px-4 py-4 md:hidden">
    <details class="group relative z-50 md:hidden">
      <summary
        class="list-none cursor-pointer p-2 text-zinc-700 marker:content-none"
        aria-label="Open mobile menu"
      >
        <span class="sr-only">Toggle mobile menu</span>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav class="absolute right-0 z-50 mt-2 w-52 rounded border border-zinc-200 bg-white p-2 shadow-lg">
        <ul class="flex flex-col">
          {nav.map((i) => (
            <li>
              <a
                href={`${base}${i.href}`}
                class={`block rounded px-3 py-2 text-sm text-zinc-700 no-underline hover:bg-zinc-100 hover:text-zinc-900 hover:no-underline ${isActive(i.href) ? "font-bold bg-zinc-100" : ""}`}
              >
                {i.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
