---
const nav = [
  { href: "", label: "Home" },
  { href: "works/", label: "Works" },
  { href: "exhibitions/", label: "Exhibitions" },
  { href: "about/", label: "About" },
  { href: "press/", label: "Press" },
]
const baseRaw = import.meta.env.BASE_URL
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`
---

<header class="border-b border-zinc-200 bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href={base} class="font-semibold no-underline hover:no-underline">Hannah Woo</a>
    <nav class="flex gap-4 text-sm">
      {nav.map((i) => (
        <a
          href={`${base}${i.href}`}
          class="text-zinc-700 hover:text-zinc-900 no-underline hover:no-underline"
        >
          {i.label}
        </a>
      ))}
    </nav>
  </div>
</header>

