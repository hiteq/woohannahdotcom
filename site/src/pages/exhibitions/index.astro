---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { loadAllContent, sortByDateDesc } from "../../lib/content"

const all = await loadAllContent()
const exhibitions = sortByDateDesc(all.filter((e) => e.type === "exhibition"))
const baseRaw = import.meta.env.BASE_URL
const base = baseRaw.endsWith("/") ? baseRaw : `${baseRaw}/`
---

<BaseLayout title="Exhibitions · Hannah Woo" description="Exhibitions">
  <div class="mb-8 border-b border-zinc-200 pb-4">
    <h1 class="text-3xl font-bold">Exhibitions</h1>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {exhibitions.map((e) => (
      <a
        href={`${base}exhibitions/${e.slug.join("/")}/`}
        class="group block no-underline"
      >
        <div class="aspect-[4/3] overflow-hidden bg-zinc-100 mb-3">
          {e.thumbnail ? (
            <img
              src={e.thumbnail}
              alt={e.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center text-zinc-400">
              No image
            </div>
          )}
        </div>
        <h3 class="font-medium text-zinc-900 group-hover:text-zinc-600 transition-colors">
          {e.title}
        </h3>
        {e.category && (
          <span class="text-sm text-zinc-500 capitalize">{e.category}</span>
        )}
      </a>
    ))}
  </div>
</BaseLayout>
